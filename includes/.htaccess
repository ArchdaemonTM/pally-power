# ═══════════════════════════════════════════════════════════════
# PALADIN PROFILE v5 — /includes/.htaccess
#
# HARD DENY — this directory is PHP-internal only.
# db.php is required via require_once from other PHP files.
# NO file in this directory should ever be web-accessible.
#
# This .htaccess is a secondary defense layer.
# Primary defense: root .htaccess blocks /includes/* with R=404.
# ═══════════════════════════════════════════════════════════════

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes -ExecCGI
